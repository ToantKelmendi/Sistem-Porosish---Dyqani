# Shabllon i konfigurimit. Kopjoje si .env dhe plotëso vlerat:
#   cp .env.example .env
#
# Skedari .env NUK futet kurrë në Git (shih .gitignore). Në CI/CD vlerat vijnë
# nga GitHub Secrets; në Kubernetes nga Secret-i spdd-secrets.

# --- Baza e porosive ---
ORDERS_DB_USER=orders_user
ORDERS_DB_PASSWORD=
ORDERS_DB_NAME=orders_db

# --- Baza e inventarit ---
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=
INVENTORY_DB_NAME=inventory_db

# --- Message broker ---
RABBITMQ_USER=spdd
RABBITMQ_PASSWORD=

# --- Çelësi i API-t (header X-API-Key) ---
# Gjenero një vlerë të rastësishme, p.sh.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
